{
    "name": "apex-dextra/fiscal-monorepo",
    "description": "Monorepo de bibliotecas PHP para documentos fiscais eletronicos.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "Fiscal\\Core\\": "packages/fiscal-core/src/",
            "Nfse\\Client\\": "packages/nfse-client/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fiscal\\Core\\Tests\\": "packages/fiscal-core/tests/",
            "Nfse\\Client\\Tests\\": "packages/nfse-client/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit --testdox"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
