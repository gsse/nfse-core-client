<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="fiscal-core">
            <directory>packages/fiscal-core/tests</directory>
        </testsuite>
        <testsuite name="nfse-client">
            <directory>packages/nfse-client/tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
